     "languageId": "raw"
    }
   },
   "source": [
    "Example 1:\n",
    "Input: gate = \"AND\", a = 1, b = 0\n",
    "Output: 0\n",
    "Explanation: AND outputs 1 only if both inputs are 1.\n",
    "\n",
    "Example 2:\n",
    "Input: gate = \"xor\", a = 1, b = 0\n",
    "Output: 1\n",
    "Explanation: XOR outputs 1 when the inputs are different. The name can be in lower case.\n",
    "\n",
    "Example 3:\n",
    "Input: gate = \"NOR\", a = 0, b = 0\n",
    "Output: 1\n",
    "Explanation: NOR outputs 1 only if both inputs are 0.\n",
    "\n",
    "Example 4:\n",
    "Input: gate = \"NAND\", a = 1, b = 1\n",
    "Output: 0"
   ]
